# Copy to .env.production, chmod 600, replace EVERY placeholder before use.
NODE_ENV=production
APP_DOMAIN=YOUR_DOMAIN
APP_URL=https://YOUR_DOMAIN
NEXTAUTH_URL=https://YOUR_DOMAIN
ACME_EMAIL=YOUR_ACME_EMAIL
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000
POSTGRES_DB=imtor
POSTGRES_USER=imtor
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
# URL-encode password punctuation. Hostname db is on private Compose networking.
DATABASE_URL=postgresql://imtor:REPLACE_WITH_RANDOM_PASSWORD@db:5432/imtor
AUTH_SECRET=REPLACE_WITH_RANDOM_32_BYTE_SECRET
AUTH_GOOGLE_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
AUTH_GOOGLE_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
ADMIN_EMAILS=
S3_PROVIDER=r2
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=YOUR_BUCKET
S3_ACCESS_KEY_ID=REPLACE_WITH_BUCKET_SCOPED_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_BUCKET_SCOPED_SECRET
S3_PUBLIC_BASE_URL=https://YOUR_PUBLIC_IMAGE_DOMAIN
S3_FORCE_PATH_STYLE=false
DEMO_MODE=false
ENABLE_DEMO_GENERATOR=false
BACKUP_DIRECTORY=./backups
BACKUP_RETENTION_DAYS=14
TZ=Asia/Bangkok
