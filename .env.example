# Local development only. Copy to .env, replace placeholders; never commit .env.
NODE_ENV=development
APP_DOMAIN=localhost
APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000
POSTGRES_DB=imtor
POSTGRES_USER=imtor
POSTGRES_PASSWORD=replace-with-local-only-password
# Host-run Bun uses localhost:55432. Container uses db:5432 (change before Compose app).
DATABASE_URL=postgresql://imtor:replace-with-local-only-password@localhost:55432/imtor

# Integration tests only: distinct local database, never the application DB.
TEST_DATABASE_URL=postgresql://imtor:replace-with-local-only-password@localhost:55432/imtor_test
AUTH_SECRET=replace-with-a-random-32-byte-secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ADMIN_EMAILS=
S3_PROVIDER=r2
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false
DEMO_MODE=false
ENABLE_DEMO_GENERATOR=false
BACKUP_DIRECTORY=./backups
BACKUP_RETENTION_DAYS=14
TZ=Asia/Bangkok
