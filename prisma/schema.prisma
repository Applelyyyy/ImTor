generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
model User {
  id String @id @default(cuid())
  name String?
  email String? @unique
  emailVerified DateTime?
  image String?
  role String @default("USER")
  suspended Boolean @default(false)
  lastLogin DateTime?
  createdAt DateTime @default(now())
  demoBatchId String?
  accounts Account[]
  sessions Session[]
  stores Store[]
  memberships StoreMember[]
  reservations Reservation[]
  uploads Upload[]
  @@index([demoBatchId])
}
model Account {
  id String @id @default(cuid())
  userId String
  type String
  provider String
  providerAccountId String
  refresh_token String? @db.Text
  access_token String? @db.Text
  expires_at Int?
  token_type String?
  scope String?
  id_token String? @db.Text
  session_state String?
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@unique([provider,providerAccountId])
}
model Session {
  id String @id @default(cuid())
  sessionToken String @unique
  userId String
  expires DateTime
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
}
model VerificationToken {
  identifier String
  token String @unique
  expires DateTime
  @@unique([identifier,token])
}
model Store {
  id String @id @default(cuid())
  slug String @unique
  name String
  description String @default("")
  imageUrl String?
  ownerId String
  kind String @default("MARKET")
  address String?
  latitude Float?
  longitude Float?
  open Boolean @default(false)
  verified Boolean @default(false)
  suspended Boolean @default(false)
  hidden Boolean @default(false)
  demoBatchId String?
  createdAt DateTime @default(now())
  owner User @relation(fields:[ownerId],references:[id])
  members StoreMember[]
  products Product[]
  attendances StoreAttendance[]
  templates AttendanceTemplate[]
  @@index([demoBatchId])
}
model StoreMember {
  id String @id @default(cuid())
  storeId String
  userId String
  role String @default("EDITOR")
  store Store @relation(fields:[storeId],references:[id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@unique([storeId,userId])
}
model MarketVenue {
  id String @id @default(cuid())
  slug String @unique
  name String
  type String @default("ตลาดนัด")
  description String @default("")
  address String @default("")
  entrance String @default("")
  latitude Float?
  longitude Float?
  timezone String @default("Asia/Bangkok")
  layoutImage String?
  active Boolean @default(true)
  demoBatchId String?
  zones MarketZone[]
  stalls MarketStall[]
  rules MarketScheduleRule[]
  exceptions MarketScheduleException[]
  sessions MarketSession[]
  templates AttendanceTemplate[]
}
model MarketZone {
  id String @id @default(cuid())
  marketId String
  name String
  market MarketVenue @relation(fields:[marketId],references:[id],onDelete:Cascade)
  stalls MarketStall[]
  @@unique([marketId,name])
}
model MarketStall {
  id String @id @default(cuid())
  marketId String
  zoneId String
  code String
  x Float
  y Float
  active Boolean @default(true)
  directions String @default("")
  market MarketVenue @relation(fields:[marketId],references:[id],onDelete:Cascade)
  zone MarketZone @relation(fields:[zoneId],references:[id],onDelete:Cascade)
  assignments StallAssignment[]
  @@unique([marketId,code])
}
model MarketScheduleRule {
  id String @id @default(cuid())
  marketId String
  weekday Int
  opens String
  closes String
  intervalWeeks Int @default(1)
  anchorDate String @default("2026-01-05")
  active Boolean @default(true)
  market MarketVenue @relation(fields:[marketId],references:[id],onDelete:Cascade)
  @@index([marketId,weekday])
}
model MarketScheduleException {
  id String @id @default(cuid())
  marketId String
  date String
  cancelled Boolean @default(false)
  opens String?
  closes String?
  reason String @default("")
  market MarketVenue @relation(fields:[marketId],references:[id],onDelete:Cascade)
  @@unique([marketId,date])
}
model MarketSession {
  id String @id @default(cuid())
  marketId String
  date String
  startsAt DateTime
  endsAt DateTime
  status String @default("SCHEDULED")
  demoBatchId String?
  market MarketVenue @relation(fields:[marketId],references:[id],onDelete:Cascade)
  attendances StoreAttendance[]
  products Product[]
  @@unique([marketId,date])
  @@index([startsAt,endsAt])
}
model StoreAttendance {
  id String @id @default(cuid())
  storeId String
  sessionId String
  status String @default("SCHEDULED")
  expectedArrival String?
  sellingUntil String?
  authorized Boolean @default(false)
  store Store @relation(fields:[storeId],references:[id],onDelete:Cascade)
  session MarketSession @relation(fields:[sessionId],references:[id],onDelete:Cascade)
  assignment StallAssignment?
  @@unique([storeId,sessionId])
}
model StallAssignment {
  id String @id @default(cuid())
  attendanceId String @unique
  stallId String
  startsAt DateTime
  endsAt DateTime
  verified Boolean @default(false)
  attendance StoreAttendance @relation(fields:[attendanceId],references:[id],onDelete:Cascade)
  stall MarketStall @relation(fields:[stallId],references:[id],onDelete:Cascade)
  @@index([stallId,startsAt,endsAt])
}
model AttendanceTemplate {
  id String @id @default(cuid())
  storeId String
  marketId String
  weekday Int
  preferredCode String?
  store Store @relation(fields:[storeId],references:[id],onDelete:Cascade)
  market MarketVenue @relation(fields:[marketId],references:[id],onDelete:Cascade)
  @@unique([storeId,marketId,weekday])
}
model ProductCategory {
  id String @id
  name String
  food Boolean @default(true)
  products Product[]
}
model Product {
  id String @id @default(cuid())
  storeId String
  sessionId String?
  categoryId String
  name String
  description String @default("")
  imageUrl String
  price Int
  mode String @default("REGULAR")
  published Boolean @default(true)
  archived Boolean @default(false)
  reservable Boolean @default(false)
  stock Int?
  pickupStart DateTime?
  pickupEnd DateTime?
  allergens String?
  storage String?
  demoBatchId String?
  createdAt DateTime @default(now())
  store Store @relation(fields:[storeId],references:[id],onDelete:Cascade)
  session MarketSession? @relation(fields:[sessionId],references:[id],onDelete:SetNull)
  category ProductCategory @relation(fields:[categoryId],references:[id])
  discounts DiscountRule[]
  reservations Reservation[]
  movements InventoryMovement[]
  reports Report[]
  @@index([published,archived,createdAt])
  @@index([storeId])
  @@index([demoBatchId])
}
model DiscountRule {
  id String @id @default(cuid())
  productId String?
  kind String
  value Int
  startsAt DateTime
  endsAt DateTime
  repeatStart String?
  repeatEnd String?
  timezone String @default("Asia/Bangkok")
  priority Int @default(0)
  product Product? @relation(fields:[productId],references:[id],onDelete:Cascade)
  @@index([productId,startsAt,endsAt])
}
model Reservation {
  id String @id @default(cuid())
  userId String
  productId String
  quantity Int
  unitPrice Int
  originalPrice Int
  productMode String @default("REGULAR")
  status String @default("RESERVED")
  pickupCode String @unique
  expiresAt DateTime
  completedAt DateTime?
  demoBatchId String?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id])
  product Product @relation(fields:[productId],references:[id])
  movements InventoryMovement[]
  @@index([status,expiresAt])
  @@index([userId,createdAt])
}
model InventoryMovement {
  id String @id @default(cuid())
  productId String
  reservationId String?
  delta Int
  reason String
  createdAt DateTime @default(now())
  product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
  reservation Reservation? @relation(fields:[reservationId],references:[id],onDelete:SetNull)
}
model SystemSetting {
  key String @id
  value Json
}
model Report {
  id String @id @default(cuid())
  productId String
  reason String
  status String @default("OPEN")
  createdAt DateTime @default(now())
  product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
}
model AuditLog {
  id String @id @default(cuid())
  actorId String
  action String
  target String
  changes Json?
  createdAt DateTime @default(now())
  @@index([createdAt])
}
model DemoBatch {
  id String @id @default(cuid())
  label String
  createdAt DateTime @default(now())
}
model Upload {
  id String @id @default(cuid())
  userId String
  key String @unique
  approvedKey String?
  mime String
  size Int
  status String @default("PENDING")
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
}
model RateLimit {
  key String @id
  count Int @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}
